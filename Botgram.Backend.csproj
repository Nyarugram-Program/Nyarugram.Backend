<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Protocol.Tests/**/*.cs;Protocol.HttpTests/**/*.cs;Storage.Tests/**/*.cs;Storage.Admin/**/*.cs" />
    <Content Remove="Storage.Admin/**;Storage.Tests/**;Protocol.Tests/**;Protocol.HttpTests/**" />
    <None Remove="Storage.Admin/**;Storage.Tests/**;Protocol.Tests/**;Protocol.HttpTests/**" />
    <PackageReference Include="Google.Protobuf" Version="[3.25.8]" />
    <PackageReference Include="Npgsql" Version="[8.0.8]" />
    <PackageReference Include="Confluent.Kafka" Version="[2.6.1]" />
    <PackageReference Include="CassandraCSharpDriver" Version="[3.22.0]" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.3]" />
    <PackageReference Include="StackExchange.Redis" Version="[2.8.24]" />
    <Content Remove="Resources/M49/**" />
    <EmbeddedResource Include="Resources/M49/botgram-m49.json" LogicalName="Botgram.M49" />
  </ItemGroup>
  <Target Name="VerifyM49Snapshot" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_M49ExpectedHash>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Resources/M49/botgram-m49.sha256').Trim())</_M49ExpectedHash>
    </PropertyGroup>
    <GetFileHash Files="$(MSBuildProjectDirectory)/Resources/M49/botgram-m49.json" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_M49Hash" />
    </GetFileHash>
    <Error Condition="'%(_M49Hash.FileHash)' != '$(_M49ExpectedHash)'" Text="M49 snapshot checksum mismatch. Run the offline M49 validation and review the pinned data update." />
  </Target>
</Project>
